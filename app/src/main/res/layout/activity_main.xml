<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/subtitle"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="14dp"
            android:text="@string/scanning"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scanMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/scanning"
            android:textSize="12sp" />

        <Button
            android:id="@+id/checkNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/check_now"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/fixNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/fix_most_important"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/launchGbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/launch_gbox_preflight"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/captureIncident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/capture_incident"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/recoveryCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/recovery_center"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/huaweiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/huawei_background_settings"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/batterySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/battery_optimization_settings"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/gboxInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/gbox_app_info"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/shareReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="@string/share_report"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/findings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="24dp"
            android:text="@string/footer_note"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
